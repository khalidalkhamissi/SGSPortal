<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>SGSForms.Api</AssemblyName>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <ItemGroup>
    <!-- Front-end UI served by Program.cs from "<content root>/Forms Source" -->
    <None Update="Forms Source\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Third-party libraries (EF Core, Pomelo MySQL, ClosedXML, PdfSharp/MigraDoc, JWT, Swagger, BCrypt)
         copied from the original deployment into ..\lib -->
    <Reference Include="..\lib\*.dll" />
  </ItemGroup>
</Project>
