{
  "Urls": "http://localhost:5200",

  // ── قاعدة البيانات ──────────────────────────────────────────────
  // لا توضع كلمة المرور هنا. تُضبط في appsettings.Production.json (غير مرفوع على git)
  // أو في متغيّر البيئة  ConnectionStrings__Default . استخدم الحساب المحدود sgs_app لا root
  // (SQL Deploy/00_create_database.sql).
  "ConnectionStrings": {
    "Default": ""
  },

  // ── JWT ─────────────────────────────────────────────────────────
  // المفتاح (32 حرفاً على الأقل) لا يوضع هنا: appsettings.Production.json أو متغيّر البيئة  Jwt__Key .
  // لكل بيئة مفتاح خاص؛ البرنامج يرفض التشغيل بدونه.
  "Jwt": {
    "Key": "",
    "Issuer": "SGSForms",
    "Audience": "SGSForms",
    "ExpireMinutes": 60
  },

  // ── بيانات تجريبية ──────────────────────────────────────────────
  // true = إنشاء حسابات تجريبية بكلمات مرور معروفة عند أول تشغيل على قاعدة فارغة.
  // للاختبار فقط — اتركه false في الإنتاج وأنشئ المدير عبر SQL Deploy/02_seed_production.sql
  "Seed": {
    "DemoUsers": false
  },

  // ── Reverse proxy ───────────────────────────────────────────────
  // عند تشغيل البرنامج خلف IIS / nginx: ضع عنوان IP للبروكسي هنا (مثال "127.0.0.1") ليُعرف عنوان المستخدم الحقيقي.
  // فارغ = لا يوجد بروكسي (لا يُوثق بترويسة X-Forwarded-For).
  "ReverseProxy": {
    "KnownProxies": []
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // الأمان: اضبط هذا على اسم النطاق الفعلي بدل "*" لمنع انتحال ترويسة Host.
  // مثال: "sgs.example.com;localhost"
  "AllowedHosts": "*"
}
